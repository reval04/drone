#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>

void drone_list(int id) {
    FILE* fp = fopen("01_test.txt", "r");
    int drone_id;
    int x, y;

    while (fscanf(fp, "%d", &drone_id)) { // 파일 입력을 모두 받을때까지 반복
        if (drone_id == id) {
            printf("drone ID:%d\n", drone_id); // 디버깅을 위한 화면 출력

            for (int i = 0; i < 5; i++) {
                fscanf(fp, "%d %d", &x, &y);
                printf("%d, %d\n", x, y);
            }
            break; // 좌표값 입력받고 반복문 종료
        }
        else { // 드론 id가 다르면 5개 좌표는 건너띈다
            for (int i = 0; i < 5; i++) {
                fscanf(fp, "%d %d", &x, &y);
            }
        }
        fclose(fp);
    }
    system("notepad.exe 01_test.txt");
}
