#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>

void drone_list(int id);
int main() {
    FILE* fp = fopen("01_test.txt", "w+");
    int drone_id = 1;

    fprintf(fp, "%d\n", drone_id);
    fprintf(fp,"0 0 "); // A좌표는 0,0으로 고정한다

    for (int i = 0; i < 4; i++) {
        int x = rand() % 501;  // 0부터 500까지 정수를 뽑는다
        int y = rand() % 501;
        fprintf(fp, "%d %d ", x, y);
    }
    fprintf(fp, "\n");
    fclose(fp);

    drone_list(drone_id);
    return 0;
}
